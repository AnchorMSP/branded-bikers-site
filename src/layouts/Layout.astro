---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Monitoring from '../components/Monitoring.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Authentic biker marketing putting your brand on rider backs across America.' } = Astro.props;

const siteUrl = Astro.site ?? new URL('https://brandedbikers.com');
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl.origin}/#organization`,
  name: 'BrandedBikers',
  alternateName: 'Branded Bikers',
  url: `${siteUrl.origin}/`,
  logo: new URL('/BBNoBG.png', siteUrl).href,
  description: 'Authentic biker marketing putting your brand on rider backs across America. BrandedBikers connects brands with real riders at rallies, rides, and events nationwide.',
  email: 'info@brandedbikers.com',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: 'info@brandedbikers.com',
      url: `${siteUrl.origin}/contact`,
    },
  ],
  areaServed: { '@type': 'Country', name: 'United States' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | BrandedBikers</title>
    <link rel="icon" type="image/png" href="/BBNoBG.png" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>
    <Monitoring />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
